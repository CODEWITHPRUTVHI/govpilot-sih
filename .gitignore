# ==========================================
# GovPilot SIH Prototype - .gitignore
# Ensure no secrets, dependencies, or builds are pushed
# ==========================================

# Dependencies (Never commit - Netlify installs automatically)
node_modules/
.pnp
.pnp.js

# Build Outputs (Never commit - Netlify builds this on CI/CD)
dist/
dist-ssr/
build/
*.local

# Environment variables & Secrets (STRICTLY FORBIDDEN ON GITHUB)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local
*.env

# Keep example template
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & IDE configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Temp & Cache
.cache/
.parcel-cache/
.temp/
tmp/
scratch/
